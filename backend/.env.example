# Application
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/kitchencraft
JWT_SECRET=change-this-development-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=604800
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
MAX_UPLOAD_SIZE_MB=5

# Optional: required only when image upload is used.
FB_API_KEY=
FB_AUTH_DOMAIN=
FB_PROJECT_ID=
FB_STORAGE_BUCKET=
FB_MESSAGING_SENDER_ID=
FB_APP_ID=

# Optional: used by `npm run seed:admin`.
ADMIN_USERNAME=
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Nutrition enrichment is intentionally disabled. Edamam/DeepL variables were removed.
